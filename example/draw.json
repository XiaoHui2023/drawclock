{
  "osc": {
    "kind": "source"
  },
  "external_clk": {
    "kind": "from"
  },
  "clock_select": {
    "kind": "mux",
    "source": {
      "0": "osc",
      "1": "external_clk"
    }
  },
  "pll_main": {
    "kind": "pll",
    "source": "clock_select"
  },
  "divider": {
    "kind": "div",
    "source": "pll_main"
  },
  "tuner": {
    "kind": "dto",
    "source": "divider"
  },
  "inverter": {
    "kind": "inv",
    "source": "tuner"
  },
  "clock_cell": {
    "kind": "cell",
    "source": "inverter"
  },
  "clock_gate": {
    "kind": "gate",
    "source": "clock_cell"
  },
  "core_clock": {
    "kind": "clock",
    "source": "clock_gate"
  }
}
